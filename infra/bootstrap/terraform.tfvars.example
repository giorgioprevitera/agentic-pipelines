# Copy to terraform.tfvars and fill in your values
# terraform.tfvars is gitignored — never commit real values

aws_account_id = "123456789012"
github_org     = "my-org"
github_repo    = "agentic-pipelines"
aws_region     = "eu-west-1"

# Only for repos with an immutable OIDC subject (default for new repos).
# Value of sub_claim_prefix from:
#   gh api repos/<org>/<repo>/actions/oidc/customization/sub
# github_sub_prefix = "repo:my-org@123456/agentic-pipelines@987654321"
project        = "agentic-pipelines"
